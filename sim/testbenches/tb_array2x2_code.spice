* ===== turn each 20-bit ACC into ONE decimal number =====
Bd00 d00 0 V = 1*u(v(c00b0)-0.9) + 2*u(v(c00b1)-0.9) + 4*u(v(c00b2)-0.9) + 8*u(v(c00b3)-0.9) + 16*u(v(c00b4)-0.9) + 32*u(v(c00b5)-0.9) + 64*u(v(c00b6)-0.9) + 128*u(v(c00b7)-0.9) + 256*u(v(c00b8)-0.9) + 512*u(v(c00b9)-0.9) + 1024*u(v(c00b10)-0.9) + 2048*u(v(c00b11)-0.9) + 4096*u(v(c00b12)-0.9) + 8192*u(v(c00b13)-0.9) + 16384*u(v(c00b14)-0.9) + 32768*u(v(c00b15)-0.9) + 65536*u(v(c00b16)-0.9) + 131072*u(v(c00b17)-0.9) + 262144*u(v(c00b18)-0.9) - 524288*u(v(c00b19)-0.9)
Bd01 d01 0 V = 1*u(v(c01b0)-0.9) + 2*u(v(c01b1)-0.9) + 4*u(v(c01b2)-0.9) + 8*u(v(c01b3)-0.9) + 16*u(v(c01b4)-0.9) + 32*u(v(c01b5)-0.9) + 64*u(v(c01b6)-0.9) + 128*u(v(c01b7)-0.9) + 256*u(v(c01b8)-0.9) + 512*u(v(c01b9)-0.9) + 1024*u(v(c01b10)-0.9) + 2048*u(v(c01b11)-0.9) + 4096*u(v(c01b12)-0.9) + 8192*u(v(c01b13)-0.9) + 16384*u(v(c01b14)-0.9) + 32768*u(v(c01b15)-0.9) + 65536*u(v(c01b16)-0.9) + 131072*u(v(c01b17)-0.9) + 262144*u(v(c01b18)-0.9) - 524288*u(v(c01b19)-0.9)
Bd10 d10 0 V = 1*u(v(c10b0)-0.9) + 2*u(v(c10b1)-0.9) + 4*u(v(c10b2)-0.9) + 8*u(v(c10b3)-0.9) + 16*u(v(c10b4)-0.9) + 32*u(v(c10b5)-0.9) + 64*u(v(c10b6)-0.9) + 128*u(v(c10b7)-0.9) + 256*u(v(c10b8)-0.9) + 512*u(v(c10b9)-0.9) + 1024*u(v(c10b10)-0.9) + 2048*u(v(c10b11)-0.9) + 4096*u(v(c10b12)-0.9) + 8192*u(v(c10b13)-0.9) + 16384*u(v(c10b14)-0.9) + 32768*u(v(c10b15)-0.9) + 65536*u(v(c10b16)-0.9) + 131072*u(v(c10b17)-0.9) + 262144*u(v(c10b18)-0.9) - 524288*u(v(c10b19)-0.9)
Bd11 d11 0 V = 1*u(v(c11b0)-0.9) + 2*u(v(c11b1)-0.9) + 4*u(v(c11b2)-0.9) + 8*u(v(c11b3)-0.9) + 16*u(v(c11b4)-0.9) + 32*u(v(c11b5)-0.9) + 64*u(v(c11b6)-0.9) + 128*u(v(c11b7)-0.9) + 256*u(v(c11b8)-0.9) + 512*u(v(c11b9)-0.9) + 1024*u(v(c11b10)-0.9) + 2048*u(v(c11b11)-0.9) + 4096*u(v(c11b12)-0.9) + 8192*u(v(c11b13)-0.9) + 16384*u(v(c11b14)-0.9) + 32768*u(v(c11b15)-0.9) + 65536*u(v(c11b16)-0.9) + 131072*u(v(c11b17)-0.9) + 262144*u(v(c11b18)-0.9) - 524288*u(v(c11b19)-0.9)

.save v(clk) v(d00) v(d01) v(d10) v(d11)

.control
run
meas tran C00 find v(d00) at=119n
meas tran C01 find v(d01) at=119n
meas tran C10 find v(d10) at=119n
meas tran C11 find v(d11) at=119n
plot v(d00) v(d01) title 'row 0 of C (decimal)'
plot v(d10) v(d11) title 'row 1 of C (decimal)'
.endc
